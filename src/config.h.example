// Copy this file to src/config.h and fill in your values.
// src/config.h is gitignored so credentials stay out of the repo.

#pragma once

// Empty SSID = no Wi-Fi at all: the device never initializes the radio and
// the poll tasks skip every rejoin until the app provisions credentials
// over BLE (see BLE_PROTOCOL.md).
#define WIFI_SSID ""
#define WIFI_PASS ""

// POSIX TZ string for your timezone (used for day-boundary streaks).
// Examples:
//   UTC:            "UTC0"
//   US Eastern:     "EST5EDT,M3.2.0/2,M11.1.0"
//   Central Europe: "CET-1CEST,M3.5.0,M10.5.0/3"
#define TZ_POSIX "UTC0"

// Standalone DCA mirror (LEGACY, disabled by default): while the app is
// disconnected, the device can poll
//   GET http://<RELAY_HOST>/api/device/<DEVICE_ID>/dca
// every 30 min for plan state (read-only; see README.md for the CSV
// contract). No secrets here — the relay must be safe to hit anonymously.
// The current backend (api.finagotchi.app) has NO such route, so the poll
// is compiled out unless you set RELAY_POLL_ENABLED 1 and point RELAY_HOST
// at a relay that implements the contract.
#define RELAY_POLL_ENABLED 0
#define RELAY_HOST "relay.example.com"
#define DEVICE_ID "finagotchi-01"

// Cloud state sync: with a device token provisioned over BLE, the device
// polls this endpoint every 60 s while no app is connected (Bearer auth).
// Override to point at a self-hosted/staging API. TLS is validated against
// the pinned root CA in api_root_ca.h (Let's Encrypt) — replace it if your
// override host uses a different issuer.
// #define STATE_SYNC_URL "https://api.finagotchi.app/device/state"

// OTA firmware manifest (OTA.md): GET ?env=<board>&v=<FW_VERSION> -> 204
// when current, else {version,url,sha256,size,notes}. Same pinned-CA TLS
// path as the state sync.
// #define FIRMWARE_MANIFEST_URL "https://api.finagotchi.app/firmware/latest"
